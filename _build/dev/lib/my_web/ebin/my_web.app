{application,my_web,
             [{compile_env,[{my_web,['Elixir.MyWebWeb.Endpoint',code_reloader],
                                    {ok,true}},
                            {my_web,['Elixir.MyWebWeb.Endpoint',debug_errors],
                                    {ok,true}},
                            {my_web,['Elixir.MyWebWeb.Endpoint',force_ssl],
                                    error},
                            {my_web,['Elixir.MyWebWeb.Gettext'],error},
                            {my_web,[dev_routes],{ok,true}}]},
              {optional_applications,[]},
              {applications,[kernel,stdlib,elixir,logger,runtime_tools,
                             phoenix,phoenix_ecto,ecto_sql,postgrex,
                             phoenix_html,phoenix_live_reload,
                             phoenix_live_view,phoenix_live_dashboard,esbuild,
                             tailwind,swoosh,req,telemetry_metrics,
                             telemetry_poller,gettext,jason,dns_cluster,
                             bandit]},
              {description,"my_web"},
              {modules,['Elixir.MyWeb','Elixir.MyWeb.Application',
                        'Elixir.MyWeb.Mailer','Elixir.MyWeb.Repo',
                        'Elixir.MyWebWeb','Elixir.MyWebWeb.CoreComponents',
                        'Elixir.MyWebWeb.Endpoint',
                        'Elixir.MyWebWeb.ErrorHTML',
                        'Elixir.MyWebWeb.ErrorJSON','Elixir.MyWebWeb.Gettext',
                        'Elixir.MyWebWeb.Layouts',
                        'Elixir.MyWebWeb.Live.HomeLive.Index',
                        'Elixir.MyWebWeb.PageController',
                        'Elixir.MyWebWeb.PageHTML','Elixir.MyWebWeb.Router',
                        'Elixir.MyWebWeb.Telemetry']},
              {registered,[]},
              {vsn,"0.1.0"},
              {mod,{'Elixir.MyWeb.Application',[]}}]}.
