



 
  <header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/90 backdrop-blur-xl shadow-lg">
  <div class="max-w-7xl mx-auto px-5 py-4 flex flex-col lg:flex-row justify-between gap-6 lg:items-center">
    <div class="flex items-center gap-4">
      <div class="w-14 h-14 rounded-2xl bg-cyan-400 flex items-center justify-center text-black text-2xl font-black shadow-md">
        PC
      </div>
      <div>
        <h1 class="text-3xl font-black tracking-wide">
          <span class="text-cyan-400">Peter</span>
          <span class="text-white"> Chileshe</span>
        </h1>
        <p class="text-slate-400 text-sm mt-1">
          Software Developer • Phoenix LiveView • Elixir Developer
        </p>  
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="flex gap-6">
      <a
          href="#projects"
          class=""
        >
          Home
        </a>
         <a
          href="#projects"
          class=""
        >
          About
        </a>

         <a
          href="#projects"
          class=""
        >
          Journey
        </a>

        <a
          href="#projects"
          class=""
        >
          Projects
        </a>
        <a
          href="#contact"
          class=""
        >
          Contact Me
        </a>
      </div>
    </div>
  </div>
</header>

  <main class="max-w-7xl mx-auto px-5 py-8">
    <section class="mb-10">
      <div class="glass rounded-3xl p-8 overflow-hidden relative">
        <div class="absolute right-0 top-0 w-72 h-72 bg-cyan-400/10 blur-3xl rounded-full"></div>
        <div class="relative z-10">
          <span class="bg-cyan-400/20 text-cyan-300 px-4 py-2 rounded-full text-sm">
            Personal Profile
          </span>

          <h2 class="text-5xl font-black mt-5 leading-tight max-w-3xl">
            PETER KANJA CHILESHE AM A SOFTWARE DEVELOPMENT.
          </h2>

          <p class="text-slate-400 mt-5 text-lg max-w-2xl leading-8">
          A passionate Full-Stack Engineer with 4+ years of experience building scalable and high-performance applications using Elixir, Phoenix LiveView, React.
          </p>

          <div class="flex flex-wrap gap-4 mt-8">
            <a
              href={~p"/my-cv"}
              download="Peter-Chileshe-CV.pdf"
              class="bg-cyan-400 hover:bg-cyan-300 text-black font-bold px-6 py-3 rounded-2xl transition inline-flex items-center justify-center"
            >
              Download CV
            </a>

            <div class="flex flex-wrap gap-2 mt-3">
          
        </div>
        </div>
        </div>
      </div>

    </section>  
    <div class="flex justify-center items-center">
      <h3 class="text-2xl font-black">About</h3> 
    </div>

     <section class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-10 mt-5">
      <div class="glass rounded-3xl p-6 xl:col-span-2">
        <div class="flex flex-col gap-6">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
            <div>
              <h3 class="text-2xl font-bold">Full-Stack Engineer</h3>
              <p class="text-slate-400 text-sm mt-1">Toggle the tab below to explore skills, experience, and education.</p>
            </div>
            <div class="flex flex-wrap gap-3">
              <button
                type="button"
                phx-click="select_tab"
                phx-value-tab="skills"
                class={[
                  "px-4 py-2 rounded-full border transition",
                  @active_tab == "skills" && "bg-cyan-400 text-black border-cyan-400",
                  @active_tab != "skills" && "bg-slate-900 text-slate-200 border-slate-700 hover:border-cyan-400"
                ]}
              >
                Skills
              </button>

              <button
                type="button"
                phx-click="select_tab"
                phx-value-tab="experience"
                class={[
                  "px-4 py-2 rounded-full border transition",
                  @active_tab == "experience" && "bg-cyan-400 text-black border-cyan-400",
                  @active_tab != "experience" && "bg-slate-900 text-slate-200 border-slate-700 hover:border-cyan-400"
                ]}
              >
                Experience
              </button>

              <button
                type="button"
                phx-click="select_tab"
                phx-value-tab="education"
                class={[
                  "px-4 py-2 rounded-full border transition",
                  @active_tab == "education" && "bg-cyan-400 text-black border-cyan-400",
                  @active_tab != "education" && "bg-slate-900 text-slate-200 border-slate-700 hover:border-cyan-400"
                ]}
              >
                Education
              </button>
            </div>
          </div>

          <div class="">
            <div class="space-y-5">
              <div class={[@active_tab != "skills" && "hidden"]}>
                <h4 class="text-xl font-semibold"></h4>
                <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div class="glass  inline-flex items-center rounded-md bg-slate-20 px-4 py-2 text-sm text-white-300">Elixir & Phoenix</div>
                  <span class="glass inline-flex items-center rounded-md bg-slate-20 px-4 py-2 text-sm text-white-300">LiveView & React</span>
                  <span class="glass inline-flex items-center rounded-md bg-slate-20 px-4 py-2 text-sm text-white-300">PostgreSQL & MySQl</span>
                  <span class=" glass inline-flex items-center rounded-md bg-slate-20 px-4 py-2 text-sm text-white-300">Responsive UI Design</span>
                </div>
              </div>

              <div class={[@active_tab != "experience" && "hidden"]}>
                <h4 class="text-xl font-semibold">Experience Highlights</h4>
                <p class="text-slate-400 mt-3">4+ years building web products with a focus on backend engineering, real-time interfaces, and production-ready deployment.</p>
                <ul class="mt-4 space-y-3 text-slate-300 list-disc list-inside">
                  <li>Built scalable Elixir/Phoenix systems with low latency and high availability.</li>
                  <li>Delivered full-stack features using LiveView, React, and modern CSS.</li>
                 
                </ul>
              </div>

              <div class={[@active_tab != "education" && "hidden"]}>
                <h4 class="text-xl font-semibold">Education</h4>
                <p class="text-slate-400 mt-3">Strong technical foundation in software engineering, computer science principles, and practical web development.</p>
                <div class="mt-4 space-y-3 text-slate-300">
                  <div>
                    <p class="font-semibold">Bachelor of Science in Computer Science</p>
                    <p class="text-slate-500 text-sm">Zicas University (2024-2026)</p>
                  </div>
                  <div>
                    <p class="font-semibold">Computer Science for secondary Teachers</p>
                    <p class="text-slate-500 text-sm">Evenly hone College (2027-2019)</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      
      <div class="glass rounded-3xl p-6">
        <div class="flex justify-between items-center mb-8">
          <div>
            <h3 class="text-2xl font-bold">
              Activity Feed
            </h3>
            <p class="text-slate-400 text-sm mt-1">
              Latest developer actions
            </p>
          </div>
          <i class="fa-solid fa-bell text-cyan-400"></i>
        </div>

        <div class="space-y-5">
          <div class="flex gap-4">
            <div class="w-12 h-12 rounded-full bg-cyan-400/20 flex items-center justify-center">
              <i class="fa-solid fa-code text-cyan-400"></i>
            </div>
            <div>
              <h4 class="font-semibold">
                Ayyam pushed new frontend update
              </h4>
              <p class="text-slate-400 text-sm mt-1">
                Improved dashboard responsiveness and pagination.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-12 h-12 rounded-full bg-violet-400/20 flex items-center justify-center">
              <i class="fa-solid fa-bug text-violet-400"></i>
            </div>
            <div>
              <h4 class="font-semibold">
                API issue resolved
              </h4>
              <p class="text-slate-400 text-sm mt-1">
                Authentication timeout bug fixed successfully.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-12 h-12 rounded-full bg-orange-400/20 flex items-center justify-center">
              <i class="fa-solid fa-rocket text-orange-400"></i>
            </div>
            <div>
              <h4 class="font-semibold">
                New deployment completed
              </h4>
              <p class="text-slate-400 text-sm mt-1">
                Production build deployed to Vercel platform.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="w-12 h-12 rounded-full bg-pink-400/20 flex items-center justify-center">
              <i class="fa-solid fa-check text-pink-400"></i>
            </div>
            <div>
              <h4 class="font-semibold">
                Sprint tasks completed
              </h4>

              <p class="text-slate-400 text-sm mt-1">
                12 frontend tasks moved to production.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <div class="flex justify-center items-center">
          <h3 class="text-2xl font-black text-center">
            Professional Journey
          </h3>
        </div>
      <div class="flex justify-between items-center mb-6">
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <!-- Todo -->
        <div class="glass rounded-3xl p-5 relative overflow-hidden rounded-2xl p-6 bg-gradient-to-br from-primary/20 to-primary/40 text-text
        border border-white/10 transition-all duration-300 hover:scale-[1.03] group ">
         <div class="flex justify-between items-center mb-5 flex  mb-4 transition-transform duration-300 group-hover:translate-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-server w-12 h-12 mr-4 text-primary transition-transform duration-300 group-hover:rotate-12"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg>
            <h4 class="font-bold text-xl">
              Backend Development
            </h4>
          </div>
          <div class="space-y-4">
            <div class=" rounded-2xl p-4">
              <p class="text-slate-400 text-sm mt-2">
                Architected scalable backend systems using Elixir and Phoenix, reducing system latency by 40% and improving overall application performance through optimized APIs, efficient concurrency handling, and real-time processing capabilities.
              </p>
            </div>
          </div>
        </div>
  
      <div class="glass rounded-3xl p-5 relative overflow-hidden rounded-2xl p-6 bg-gradient-to-br from-primary/20 to-primary/40 text-text
        border border-white/10 transition-all duration-300 hover:scale-[1.03] group ">
          <div class="flex justify-between items-center mb-4 transition-transform duration-300 group-hover:translate-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-code w-12 h-12 mr-4 text-secondary transition-transform duration-300 group-hover:rotate-12"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            <h4 class="font-bold text-xl">
              Frontend Deployment
            </h4>  
          </div>

          <div class="space-y-4">
            <div class="bg-slate-900 rounded-2xl p-4 task-card">
              <h5 class="font-semibold">
                Team management module
              </h5>
              <p class="text-slate-400 text-sm mt-2">
                Backend integration ongoing.
              </p>
            </div>

            <div class="bg-slate-900 rounded-2xl p-4 task-card">
              <h5 class="font-semibold">
                AI analytics integration
              </h5>
              <p class="text-slate-400 text-sm mt-2">
                Smart insights feature development.
              </p>
            </div>
          </div>
        </div>

        
        <div class="glass rounded-3xl p-5 relative overflow-hidden rounded-2xl p-6 bg-gradient-to-br from-primary/20 to-primary/40 text-text
           border border-white/10 transition-all duration-300 hover:scale-[1.03] group ">
          <div class="flex justify-between items-center mb-5 flex  mb-4 transition-transform duration-300 group-hover:translate-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-database w-12 h-12 mr-4 text-primary transition-transform duration-300 group-hover:rotate-12"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg>
            <h4 class="font-bold text-xl">
              Databa management
            </h4>   
          </div>

          <div class="space-y-4">
            <div class="bg-slate-900 rounded-2xl p-4 task-card">
              <h5 class="font-semibold">
                UI redesign approval
              </h5>
              <p class="text-slate-400 text-sm mt-2">
                Waiting for design validation.
              </p>
            </div>
          </div>
        </div>            
      </div>
    </section>
  
     <div class="flex justify-center items-center">
      <h3 class="text-2xl font-black">Featured Projects</h3> 
    </div>

    <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-10 mt-5"> 
      <div class="glass rounded-3xl p-6 card-hover">
        <div class="flex justify-between mb-6">
          <span class="text-slate-400">Projects</span>
          <i class="fa-solid fa-diagram-project text-cyan-400"></i>
        </div>
        <h3 class="text-5xl font-black">48</h3>
        <p class="text-emerald-400 mt-3 text-sm">
          +12% this month
        </p>
      </div>

      <div class="glass rounded-3xl p-6 card-hover">
        <div class="flex justify-between mb-6">
          <span class="text-slate-400">Deployments</span>
          <i class="fa-solid fa-rocket text-violet-400"></i>
        </div>

        <h3 class="text-5xl font-black">126</h3>
        <p class="text-violet-400 mt-3 text-sm">
          CI/CD pipelines active
        </p>
      </div>

      <div class="glass rounded-3xl p-6 card-hover">
        <div class="flex justify-between mb-6">
          <span class="text-slate-400">Git Commits</span>
          <i class="fa-solid fa-code-commit text-orange-400"></i>
        </div>
        <h3 class="text-5xl font-black">8.4K</h3>
        <p class="text-orange-400 mt-3 text-sm">
          Across repositories
        </p>
      </div>

      <div class="glass rounded-3xl p-6 card-hover">
        <div class="flex justify-between mb-6">
          <span class="text-slate-400">Performance</span>
          <i class="fa-solid fa-chart-line text-pink-400"></i>
        </div>
        <h3 class="text-5xl font-black">94%</h3>
        <p class="text-pink-400 mt-3 text-sm">
          Team productivity score
        </p>
      </div>
    </section>
  </main>

  


